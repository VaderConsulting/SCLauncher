<Window x:Class="SCLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC Launcher" Height="336.355" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="SCSMLogo2.ico">
    <Grid Margin="0,0,-75,0" HorizontalAlignment="Left" Width="500">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MinHeight="89" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MinHeight="22" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="75" />
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Image Width="200" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" Margin="10,10,0,0">

            <Image.Source>

                <BitmapImage DecodePixelWidth="200" UriSource="SCLogo.gif">

                </BitmapImage>

            </Image.Source>

        </Image>

        <Label x:Name="lblServerSelection" Margin="0,11,0,52" Content="SCOM:"  VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0" Height="26" Width="70" />

        <ComboBox x:Name="cmbSCOMServer" Grid.Column="1" Grid.Row="1"  Width="320" HorizontalAlignment="left" ToolTip="Select a Server" VerticalAlignment="Center" Margin="5,15,0,59" Height="22">
        </ComboBox>
        <CheckBox x:Name="chkCloseLauncher" VerticalAlignment="Center" Margin="5,6,0,0"  Grid.Column="1" Grid.Row="2" Height="18" Content="Close Launcher Once Started" />

        <Button x:Name="btnLaunchSCOM" Content="Start" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" Margin="330,15,0,0"  VerticalAlignment="Top" Width="75" Click="btnLaunchSCOM_Click" Height="22"/>

        <TextBlock Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,20,0" Width="43">
            <Hyperlink x:Name="hypEmailLink" NavigateUri="mailto:example@example.com" Click="hypEmailLink_Click">
                Support
            </Hyperlink>
        </TextBlock>
        <Label x:Name="lblServerSelection_Copy" Margin="0,44,0,23" Content="SCSM:"  VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0" Height="26" Width="70" />
        <ComboBox x:Name="cmbSCSMServer" Grid.Column="1" Grid.Row="1"  Width="320" HorizontalAlignment="left" ToolTip="Select a Server" VerticalAlignment="Center" Margin="5,50,0,25" Height="22"/>
        <Button x:Name="btnLaunchSCSM" Content="Start" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" Margin="330,51,0,0"  VerticalAlignment="Top" Width="75" Click="btnLaunchSCSM_Click" Height="22"/>

    </Grid>
</Window>
